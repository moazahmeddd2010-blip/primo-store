<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#080808">
<title>PRIMO STORE | ADMIN</title>
<style>
:root{--gold:#f5c542;--gold2:#ffe9a3;--bg:#080808;--panel:#141414;--line:#443318;--red:#e93636}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:white;font-family:Arial,Tahoma,sans-serif}
button,input,textarea,select{font:inherit}button{cursor:pointer}
header{position:sticky;top:0;z-index:10;background:#090909ee;backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav{max-width:1000px;margin:auto;padding:15px;display:flex;justify-content:space-between;align-items:center;gap:10px}
.logo{color:var(--gold);font-size:21px;font-weight:1000;text-shadow:0 0 15px #f5c54266}
.logo small{display:block;text-align:center;color:#999;font-size:9px;letter-spacing:3px;margin-top:4px}
.admin-tag{color:var(--gold);border:1px solid var(--line);border-radius:20px;padding:8px 11px;font-size:11px}
.container{max-width:1000px;margin:auto;padding:16px}
.hero{text-align:center;padding:25px 12px;border:1px solid var(--line);border-radius:20px;background:linear-gradient(130deg,#241a08,#111,#080808);box-shadow:0 0 25px #f5c54212}
.hero h1{color:var(--gold);margin:0 0 8px}.hero p{color:#999;font-size:12px;line-height:1.8}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:15px 0}
.stat{padding:14px 7px;text-align:center;border:1px solid var(--line);border-radius:13px;background:#141414}
.stat b{display:block;color:var(--gold);font-size:23px}.stat span{font-size:11px;color:#999}
.panel{margin-top:16px;padding:17px;border:1px solid var(--line);border-radius:18px;background:linear-gradient(145deg,#171717,#0e0e0e)}
.panel-title{color:var(--gold);font-size:17px;margin:0 0 17px;padding-bottom:12px;border-bottom:1px solid #302719}
.field{margin-bottom:14px}.field label{display:block;font-size:12px;color:#ddd;margin-bottom:7px}
.field small{display:block;color:#888;font-size:10px;line-height:1.8;margin-top:6px}
input,textarea,select{width:100%;padding:13px;color:white;background:#090909;border:1px solid #493719;border-radius:11px;outline:none}
input:focus,textarea:focus,select:focus{border-color:var(--gold);box-shadow:0 0 10px #f5c54218}
textarea{min-height:100px;resize:vertical;line-height:1.8}select option{background:#111}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.upload-box{padding:14px;border:1px dashed #806020;border-radius:13px;background:#0c0c0c}
.upload-box input{padding:9px;background:#151515}
.preview{display:flex;flex-wrap:wrap;gap:9px;margin-top:10px}
.preview-item{position:relative;width:85px;height:85px;border:1px solid #66501f;border-radius:10px;overflow:hidden;background:#171717}
.preview-item img{width:100%;height:100%;object-fit:cover}
.preview-item button{position:absolute;top:3px;left:3px;width:23px;height:23px;border:0;border-radius:50%;background:#b90000;color:white;font-size:14px}
.file-status{font-size:11px;color:#aaa;margin-top:8px}
.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:17px}
.btn{border:0;border-radius:11px;padding:13px 16px;font-weight:bold;font-size:12px}
.primary{background:linear-gradient(100deg,#b8860b,#ffe08a,#c59620);color:#111;flex:1}
.secondary{background:#242424;color:var(--gold);border:1px solid var(--line)}
.danger{background:#4a1010;color:#ffaaaa}.success{color:#a5ffb5}
.program-list{display:grid;gap:11px}
.program{display:flex;align-items:center;gap:12px;padding:12px;background:#0d0d0d;border:1px solid #382b18;border-radius:13px}
.program img{width:65px;height:65px;object-fit:cover;border-radius:10px;background:#222}
.program-info{flex:1;min-width:0}
.program-info b{display:block;color:var(--gold);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.program-info small{display:block;color:#999;font-size:10px;margin-top:6px}
.program-buttons{display:flex;gap:5px;flex-wrap:wrap}
.program-buttons button{border:1px solid #59451e;border-radius:8px;background:#191919;color:#eee;padding:8px;font-size:10px}
.program-buttons .delete{color:#ff8585;border-color:#702828}
.badge{display:inline-block;padding:4px 7px;border-radius:20px;font-size:9px;margin-top:5px;background:#273c24;color:#aaffaa}
.badge.draft{background:#49371c;color:#ffe09a}
.empty{text-align:center;padding:25px;color:#888;border:1px dashed #493719;border-radius:12px}
.message{display:none;padding:12px;border-radius:10px;margin-top:12px;font-size:12px;line-height:1.8}
.message.show{display:block}.message.ok{background:#12301c;color:#aaffbb}.message.error{background:#391414;color:#ffaaaa}
.hidden{display:none!important}
button:disabled{opacity:.6;cursor:wait}
footer{text-align:center;color:#666;font-size:11px;padding:25px}
@media(max-width:600px){.grid2{grid-template-columns:1fr}.program{align-items:flex-start;flex-wrap:wrap}.program-buttons{width:100%}.program-buttons button{flex:1}.stats{gap:6px}}
</style>
</head>
<body>
<header><div class="nav"><div class="logo">𝑷𝑹𝑰𝑴𝑶 𝑺𝑻𝑶𝑹𝑬<small>ADMIN CONTROL PANEL</small></div><div class="admin-tag">👑 لوحة الإدارة</div></div></header>
<main class="container">
<section class="hero"><h1>لوحة تحكم بريمو ستور</h1><p>إدارة التطبيقات والألعاب والصور وروابط التحميل والشرح</p></section>
<section class="stats">
<div class="stat"><b id="totalCount">0</b><span>كل البرامج</span></div>
<div class="stat"><b id="publishedCount">0</b><span>المنشورة</span></div>
<div class="stat"><b id="draftCount">0</b><span>المسودات</span></div>
</section>
<section class="panel">
<h2 class="panel-title" id="formTitle">➕ إضافة برنامج جديد</h2>
<form id="programForm">
<div class="field"><label>اسم البرنامج *</label><input id="name" required placeholder="مثال: بريمو كيبورد"></div>
<div class="grid2">
<div class="field"><label>التصنيف</label><select id="category"><option>تطبيقات</option><option>ألعاب</option><option>أدوات</option><option>تصميم</option><option>تعليم</option><option>أخرى</option></select></div>
<div class="field"><label>رقم الإصدار</label><input id="version" placeholder="1.0.0"></div>
</div>
<div class="grid2">
<div class="field"><label>حجم البرنامج</label><input id="size" placeholder="مثال: 25 MB"></div>
<div class="field"><label>اسم المطور</label><input id="developer" placeholder="اسم المطور"></div>
</div>
<div class="field"><label>الوصف المختصر</label><textarea id="description" placeholder="اكتب وصف البرنامج الذي سيظهر في المتجر..."></textarea></div>
<div class="field"><label>تفاصيل البرنامج الكاملة</label><textarea id="details" style="min-height:160px" placeholder="اكتب هنا كل تفاصيل البرنامج، المميزات، طريقة الاستخدام، المتطلبات وأي معلومات إضافية..."></textarea><small>هذا النص سيظهر في صفحة تفاصيل البرنامج.</small></div>
<h3 class="panel-title">🖼 صور البرنامج</h3>
<div class="field upload-box"><label>أيقونة البرنامج</label><input type="file" id="iconFile" accept="image/*"><div class="preview" id="iconPreview"></div><small>الصورة الدائرية التي تظهر في صفحة البرنامج.</small></div>
<div class="field upload-box"><label>صورة الغلاف الرئيسية</label><input type="file" id="coverFile" accept="image/*"><div class="preview" id="coverPreview"></div><small>الصورة الكبيرة أعلى صفحة تفاصيل البرنامج وصورة الكارت.</small></div>
<div class="field upload-box"><label>صور إضافية (حتى 6 صور)</label><input type="file" id="galleryFiles" accept="image/*" multiple><div class="preview" id="galleryPreview"></div><small>تقدر تختار الصور من معرض الموبايل. الحد الأقصى 6 صور إجمالًا.</small></div>
<h3 class="panel-title">⬇️ تحميل البرنامج</h3>
<div class="field"><label>طريقة التحميل</label><select id="downloadMode"><option value="url">رابط تحميل خارجي</option><option value="file">رفع APK من الهاتف</option></select></div>
<div class="field" id="urlBox"><label>رابط التحميل</label><input id="download" type="url" placeholder="https://example.com/app.apk" dir="ltr"></div>
<div class="field upload-box hidden" id="apkBox"><label>اختيار ملف APK</label><input type="file" id="apkFile" accept=".apk,application/vnd.android.package-archive"><div class="file-status" id="apkStatus">لم يتم اختيار ملف APK جديد.</div><small>تنبيه: الملف يُحفظ محليًا على هذا الجهاز والمتصفح فقط، ولا يصبح متاحًا للزوار تلقائيًا.</small></div>
<h3 class="panel-title">▶️ شرح البرنامج</h3>
<div class="field"><label>رابط فيديو يوتيوب</label><input id="video" type="url" placeholder="https://www.youtube.com/watch?v=..." dir="ltr"><small>عند إضافة الرابط سيظهر زر شرح البرنامج في صفحة التفاصيل.</small></div>
<div class="field"><label>حالة البرنامج</label><select id="status"><option value="published">نشر البرنامج في المتجر</option><option value="draft">حفظ كمسودة</option></select></div>
<div class="actions"><button type="submit" class="btn primary" id="saveButton">💾 حفظ البرنامج</button><button type="button" class="btn secondary" id="resetButton">إلغاء / جديد</button></div>
<div class="message" id="message" role="status" aria-live="polite"></div>
</form>
</section>
<section class="panel"><h2 class="panel-title">📦 البرامج الموجودة</h2><div class="field"><input id="adminSearch" placeholder="🔎 ابحث عن برنامج..."></div><div class="program-list" id="programList"><div class="empty">جاري تحميل البرامج...</div></div></section>
<section class="panel"><h2 class="panel-title">🗄 النسخ الاحتياطي</h2><p style="color:#999;font-size:12px;line-height:2">يمكنك تصدير بيانات البرامج كملف JSON أو استيراد نسخة بيانات سابقة. النسخة JSON لا تتضمن ملفات الصور وAPK المخزنة في قاعدة الملفات.</p><div class="actions"><button type="button" class="btn secondary" id="exportButton">📤 تصدير البيانات</button><button type="button" class="btn secondary" id="importButton">📥 استيراد البيانات</button><input type="file" id="importFile" accept=".json,application/json" hidden></div></section>
</main>
<footer>𝑷𝑹𝑰𝑴𝑶 𝑺𝑻𝑶𝑹𝑬 — ADMIN PANEL</footer>
<script>
"use strict";
/* إعدادات التخزين المحلي */
const STORAGE_KEY="q3da_store_admin_v2",DB_NAME="PRIMO_STORE_FILES_V4",DB_VERSION=1;
let programs=[],editingId=null,databasePromise=null,selectedIcon=null,selectedCover=null,selectedGallery=[],removedGallery=[],previewURLs=[];
const $=id=>document.getElementById(id);
function makeId(){return "primo_"+Date.now()+"_"+Math.random().toString(36).slice(2,9)}
function message(text,type="ok"){const box=$("message");box.textContent=text;box.className="message show "+type}
function clearMessage(){$("message").className="message";$("message").textContent=""}
function openDB(){
 if(databasePromise)return databasePromise;
 databasePromise=new Promise((resolve,reject)=>{
  if(!window.indexedDB){reject(new Error("المتصفح لا يدعم تخزين الملفات"));return}
  const request=indexedDB.open(DB_NAME,DB_VERSION);
  request.onupgradeneeded=()=>{const db=request.result;if(!db.objectStoreNames.contains("files"))db.createObjectStore("files",{keyPath:"id"})};
  request.onsuccess=()=>{const db=request.result;if(!db.objectStoreNames.contains("files")){reject(new Error("مخزن الملفات غير موجود"));return}resolve(db)};
  request.onerror=()=>{databasePromise=null;reject(request.error||new Error("تعذر فتح قاعدة الملفات"))};
 });
 return databasePromise;
}
async function saveFile(file){
 if(!file)return "";const db=await openDB(),id=makeId();
 return new Promise((resolve,reject)=>{const tx=db.transaction("files","readwrite");tx.objectStore("files").put({id,blob:file,name:file.name||"file",type:file.type||"",size:file.size||0,createdAt:Date.now()});tx.oncomplete=()=>resolve(id);tx.onerror=()=>reject(tx.error);tx.onabort=()=>reject(tx.error||new Error("تم إلغاء حفظ الملف"))});
}
async function deleteStoredFile(id){
 if(!id)return;const db=await openDB();
 return new Promise((resolve,reject)=>{const tx=db.transaction("files","readwrite");tx.objectStore("files").delete(id);tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error)});
}
async function getStoredImageURL(id){
 try{const db=await openDB();return await new Promise((resolve,reject)=>{const tx=db.transaction("files","readonly"),req=tx.objectStore("files").get(id);req.onsuccess=()=>resolve(req.result?.blob?URL.createObjectURL(req.result.blob):"");req.onerror=()=>reject(req.error)})}
 catch(error){return ""}
}
function loadData(){
 try{const saved=JSON.parse(localStorage.getItem(STORAGE_KEY)||"[]");programs=Array.isArray(saved)?saved:[]}
 catch(error){programs=[]}
 renderList();updateStats();
}
function saveData(){localStorage.setItem(STORAGE_KEY,JSON.stringify(programs))}
function clearPreviewURLs(){previewURLs.forEach(url=>URL.revokeObjectURL(url));previewURLs=[]}
function createPreview(file){const url=URL.createObjectURL(file);previewURLs.push(url);return url}
function showSinglePreview(file,containerId){const root=$(containerId);root.innerHTML="";if(!file)return;const url=createPreview(file);const item=document.createElement("div");item.className="preview-item";const img=document.createElement("img");img.src=url;img.alt="معاينة الصورة";item.appendChild(img);root.appendChild(item)}
async function showGalleryPreview(){
 const root=$("galleryPreview");root.innerHTML="";const oldProgram=programs.find(p=>p.id===editingId),oldIds=oldProgram?.images?.gallery||[];
 for(const id of oldIds){if(removedGallery.includes(id))continue;const item=document.createElement("div");item.className="preview-item";const img=document.createElement("img");img.alt="صورة محفوظة";item.appendChild(img);const remove=document.createElement("button");remove.type="button";remove.textContent="×";remove.title="إزالة الصورة";remove.onclick=()=>{removedGallery.push(id);showGalleryPreview()};item.appendChild(remove);root.appendChild(item);getStoredImageURL(id).then(url=>{if(url)img.src=url})}
 selectedGallery.forEach((file,index)=>{const item=document.createElement("div");item.className="preview-item";const img=document.createElement("img");img.src=createPreview(file);img.alt="معاينة صورة جديدة";item.appendChild(img);const remove=document.createElement("button");remove.type="button";remove.textContent="×";remove.onclick=()=>{selectedGallery.splice(index,1);showGalleryPreview()};item.appendChild(remove);root.appendChild(item)});
}
$("iconFile").addEventListener("change",()=>{selectedIcon=$("iconFile").files[0]||null;showSinglePreview(selectedIcon,"iconPreview")});
$("coverFile").addEventListener("change",()=>{selectedCover=$("coverFile").files[0]||null;showSinglePreview(selectedCover,"coverPreview")});
$("galleryFiles").addEventListener("change",()=>{const files=Array.from($("galleryFiles").files||[]),old=programs.find(p=>p.id===editingId),oldCount=(old?.images?.gallery||[]).filter(id=>!removedGallery.includes(id)).length,available=Math.max(0,6-oldCount-selectedGallery.length);selectedGallery=selectedGallery.concat(files.slice(0,available));if(files.length>available)alert("الحد الأقصى للصور الإضافية هو 6 صور.");$("galleryFiles").value="";showGalleryPreview()});
$("downloadMode").addEventListener("change",()=>{const isFile=$("downloadMode").value==="file";$("apkBox").classList.toggle("hidden",!isFile);$("urlBox").classList.toggle("hidden",isFile)});
$("apkFile").addEventListener("change",()=>{const file=$("apkFile").files[0];$("apkStatus").textContent=file?"تم اختيار: "+file.name+" — "+(file.size/1024/1024).toFixed(2)+" MB":"لم يتم اختيار ملف APK جديد."});
function resetForm(){
 editingId=null;selectedIcon=null;selectedCover=null;selectedGallery=[];removedGallery=[];$("programForm").reset();$("iconPreview").innerHTML="";$("coverPreview").innerHTML="";$("galleryPreview").innerHTML="";$("apkStatus").textContent="لم يتم اختيار ملف APK جديد.";$("downloadMode").value="url";$("downloadMode").dispatchEvent(new Event("change"));$("formTitle").textContent="➕ إضافة برنامج جديد";$("saveButton").textContent="💾 حفظ البرنامج";clearMessage();clearPreviewURLs();
}
async function editProgram(id){
 const p=programs.find(x=>String(x.id)===String(id));if(!p)return;resetForm();editingId=p.id;
 $("name").value=p.name||"";$("category").value=p.category||"تطبيقات";$("version").value=p.version||"";$("size").value=p.size||"";$("developer").value=p.developer||"";$("description").value=p.description||"";$("details").value=p.details||p.fullDescription||"";$("video").value=p.video||"";$("status").value=p.status||"draft";
 const images=p.images||{};
 if(images.icon){const url=await getStoredImageURL(images.icon);if(url){const item=document.createElement("div");item.className="preview-item";const img=document.createElement("img");img.src=url;item.appendChild(img);$("iconPreview").appendChild(item)}}
 if(images.cover){const url=await getStoredImageURL(images.cover);if(url){const item=document.createElement("div");item.className="preview-item";const img=document.createElement("img");img.src=url;item.appendChild(img);$("coverPreview").appendChild(item)}}
 $("downloadMode").value=p.fileId?"file":"url";$("downloadMode").dispatchEvent(new Event("change"));$("download").value=p.download||"";$("apkStatus").textContent=p.fileId?"يوجد ملف APK محفوظ مسبقًا. اختر ملفًا جديدًا لاستبداله.":"لم يتم اختيار ملف APK جديد.";await showGalleryPreview();$("formTitle").textContent="✏️ تعديل البرنامج";$("saveButton").textContent="💾 حفظ التعديلات";window.scrollTo({top:0,behavior:"smooth"});
}
$("programForm").addEventListener("submit",async e=>{
 e.preventDefault();const button=$("saveButton");button.disabled=true;button.textContent="جاري الحفظ...";clearMessage();
 try{
  const name=$("name").value.trim();if(!name)throw new Error("اكتب اسم البرنامج أولًا.");
  const old=programs.find(p=>String(p.id)===String(editingId)),oldImages=old?.images||{};
  let iconId=oldImages.icon||"",coverId=oldImages.cover||"";
  if(selectedIcon)iconId=await saveFile(selectedIcon);if(selectedCover)coverId=await saveFile(selectedCover);
  let galleryIds=(oldImages.gallery||[]).filter(id=>!removedGallery.includes(id));
  for(const file of selectedGallery){if(galleryIds.length>=6)break;galleryIds.push(await saveFile(file))}
  galleryIds=galleryIds.slice(0,6);
  const mode=$("downloadMode").value;let download="",fileId=old?.fileId||"";
  if(mode==="url"){download=$("download").value.trim();if(download){const u=new URL(download);if(!["http:","https:"].includes(u.protocol))throw new Error("رابط التحميل غير صحيح.")}fileId=""}
  else{const apk=$("apkFile").files[0];if(apk){if(!apk.name.toLowerCase().endsWith(".apk"))throw new Error("اختر ملف APK صحيح.");fileId=await saveFile(apk)}if(!fileId)throw new Error("اختر ملف APK من هاتفك.")}
  const video=$("video").value.trim();if(video){const u=new URL(video);if(!["http:","https:"].includes(u.protocol))throw new Error("رابط الفيديو غير صحيح.")}
  const program={id:old?.id||makeId(),name,category:$("category").value,version:$("version").value.trim(),size:$("size").value.trim(),developer:$("developer").value.trim(),description:$("description").value.trim(),details:$("details").value.trim(),images:{icon:iconId,cover:coverId,gallery:galleryIds},image:"",fileId,download,downloadMode:mode,video,status:$("status").value,createdAt:old?.createdAt||Date.now(),updatedAt:Date.now()};
  if(old){const index=programs.findIndex(p=>String(p.id)===String(editingId));programs[index]=program}else programs.unshift(program);
  saveData();const savedName=program.name;resetForm();loadData();message("تم حفظ «"+savedName+"» بنجاح ✅","ok");
 }catch(error){console.error("Save error:",error);message("تعذر الحفظ: "+(error.message||"خطأ غير معروف"),"error")}
 finally{button.disabled=false;button.textContent=editingId?"💾 حفظ التعديلات":"💾 حفظ البرنامج"}
});
$("resetButton").addEventListener("click",resetForm);
function escapeHTML(value){return String(value??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function escapeAttr(value){return escapeHTML(value)}
async function renderList(){
 const q=$("adminSearch").value.trim().toLowerCase(),list=programs.filter(p=>String(p.name||"").toLowerCase().includes(q)),root=$("programList");
 if(!list.length){root.innerHTML='<div class="empty">لا توجد برامج حتى الآن.</div>';return}
 root.innerHTML=list.map(p=>{const published=p.status==="published";return `<div class="program"><img data-thumb="${escapeAttr(p.id)}" src="" alt=""><div class="program-info"><b>${escapeHTML(p.name)}</b><small>${escapeHTML(p.category||"تطبيقات")} · ${escapeHTML(p.version||"")}</small><span class="badge ${published?"":"draft"}">${published?"منشور":"مسودة"}</span></div><div class="program-buttons"><button data-edit="${escapeAttr(p.id)}">✏️ تعديل</button><button data-toggle="${escapeAttr(p.id)}">${published?"إخفاء":"نشر"}</button><button class="delete" data-delete="${escapeAttr(p.id)}">🗑 حذف</button></div></div>`}).join("");
 for(const p of list){const imageId=p.images?.icon||p.images?.cover;if(!imageId)continue;const url=await getStoredImageURL(imageId),img=Array.from(root.querySelectorAll("[data-thumb]")).find(el=>el.dataset.thumb===String(p.id));if(img&&url)img.src=url}
}
function updateStats(){$("totalCount").textContent=programs.length;$("publishedCount").textContent=programs.filter(p=>p.status==="published").length;$("draftCount").textContent=programs.filter(p=>p.status!=="published").length}
$("adminSearch").addEventListener("input",renderList);
$("programList").addEventListener("click",async e=>{
 const edit=e.target.closest("[data-edit]"),toggle=e.target.closest("[data-toggle]"),del=e.target.closest("[data-delete]");
 if(edit){await editProgram(edit.dataset.edit);return}
 if(toggle){const p=programs.find(x=>String(x.id)===String(toggle.dataset.toggle));if(!p)return;p.status=p.status==="published"?"draft":"published";saveData();loadData();return}
 if(del){const id=del.dataset.delete,p=programs.find(x=>String(x.id)===String(id));if(!p||!confirm("هل أنت متأكد من حذف البرنامج؟"))return;
  try{const images=p.images||{},ids=[images.icon,images.cover,...(images.gallery||[]),p.fileId].filter(Boolean);for(const fileId of new Set(ids))await deleteStoredFile(fileId);programs=programs.filter(x=>String(x.id)!==String(id));saveData();loadData();if(String(editingId)===String(id))resetForm()}
  catch(error){alert("تعذر حذف بعض الملفات: "+error.message)}
 }
});
$("exportButton").addEventListener("click",()=>{try{const blob=new Blob([JSON.stringify(programs,null,2)],{type:"application/json"}),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download="PRIMO_STORE_BACKUP.json";a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}catch(error){alert("فشل تصدير البيانات.")}});
$("importButton").addEventListener("click",()=>$("importFile").click());
$("importFile").addEventListener("change",async()=>{const file=$("importFile").files[0];if(!file)return;try{const data=JSON.parse(await file.text());if(!Array.isArray(data))throw new Error("ملف النسخة الاحتياطية غير صحيح.");if(!confirm("سيتم استبدال قائمة البرامج الحالية بالبيانات المستوردة. هل تريد المتابعة؟"))return;programs=data;saveData();loadData();alert("تم استيراد البيانات بنجاح. الصور وملفات APK لا تنتقل مع ملف JSON.")}catch(error){alert("تعذر الاستيراد: "+error.message)}finally{$("importFile").value=""}});
$("downloadMode").dispatchEvent(new Event("change"));loadData();
</script>
</body>
</html>
